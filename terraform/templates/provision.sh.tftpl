#!/usr/bin/env bash
# Generated by Terraform. The AWS counterpart of bin/setup-test-store.sh: same
# storefront, minus the local-only step of minting an API key from a Compound
# identity service running on the developer's machine. The key arrives as a
# Terraform variable instead.
#
# Idempotent - `make aws-deploy` re-runs it after every plugin or config change.
set -euo pipefail
cd /opt/compound-store

set -a
. ./.env
set +a

wp() { docker compose exec -T cli wp "$@"; }

echo "==> waiting for WordPress + the database to answer"
for _ in $(seq 1 60); do
  wp core version >/dev/null 2>&1 && break
  sleep 3
done
wp core version >/dev/null || { echo "wp-cli never came up; check 'docker compose logs'"; exit 1; }

if ! wp core is-installed >/dev/null 2>&1; then
  echo "==> installing WordPress at ${site_url}"
  wp core install \
    --url='${site_url}' \
    --title='${site_title}' \
    --admin_user='${wp_admin_user}' \
    --admin_password="$WP_ADMIN_PASSWORD" \
    --admin_email='${wp_admin_email}' \
    --skip-email
else
  # Re-assert on every deploy: if the Elastic IP ever changes, so does the hostname.
  wp option update home '${site_url}' >/dev/null
  wp option update siteurl '${site_url}' >/dev/null
fi

# The wordpress image seeds an empty volume and then leaves it alone - it will not
# upgrade an existing install, so bumping the image tag does not move core. WordPress
# stays on whatever version first landed, and current WooCommerce refuses to install
# below its "Requires at least" floor. Pull core forward explicitly, then migrate the
# schema (the "database update required" screen, answered before anyone sees it).
echo "==> WordPress core ($(wp core version 2>/dev/null || echo unknown)) -> latest"
wp core update >/dev/null
wp core update-db >/dev/null 2>&1 || true

echo "==> WooCommerce + the Compound gateway plugin"
wp plugin is-active woocommerce >/dev/null 2>&1 || wp plugin install woocommerce --activate >/dev/null
wp plugin is-active compound-woocommerce >/dev/null 2>&1 || wp plugin activate compound-woocommerce >/dev/null

# The restricted-product storefront compliance controls (age gate, account-only checkout,
# mandatory COAs, disabled reviews - COMPLIANCE.md) are this reference storefront's own
# regulatory posture, not something the plugin imposes on every merchant by default - see
# compound-gateway.php. This deployment explicitly opts in.
wp config set COMPOUND_WC_ENABLE_COMPLIANCE true --raw --type=constant >/dev/null 2>&1 || true

echo "==> store settings"
wp option update blogname '${site_title}' >/dev/null
wp option update blogdescription "Research peptides, shipped fast" >/dev/null
wp option update woocommerce_currency USD >/dev/null
wp option update woocommerce_default_country "US:CA" >/dev/null
wp option update woocommerce_store_country "US:CA" >/dev/null
# WooCommerce 9.1+ parks a new store behind a "coming soon" splash: every page a
# logged-out visitor requests returns 200 with "Something big is brewing" instead of
# the storefront. The site looks healthy from outside and has no shop at all.
wp option update woocommerce_coming_soon no >/dev/null 2>&1 || true
# Keep the onboarding wizard from hijacking the first wp-admin visit.
wp option update woocommerce_onboarding_profile '{"skipped":true}' --format=json >/dev/null 2>&1 || true
wp option update woocommerce_task_list_hidden yes >/dev/null 2>&1 || true
wp rewrite structure '/%postname%/' >/dev/null 2>&1 || true
wp rewrite flush --hard >/dev/null 2>&1 || true

# The primary navigation always links to this dynamic directory. Create it once,
# but preserve any merchant-authored replacement on later deploys.
CERTIFICATES_ID="$(wp post list --post_type=page --name=certificates --field=ID --format=ids)"
if [ -z "$CERTIFICATES_ID" ]; then
  wp post create --post_type=page --post_status=publish --post_title="Certificates" \
    --post_name=certificates --post_content='[compound_certificates]' >/dev/null
fi
SHOP_ID="$(wp option get woocommerce_shop_page_id)"
wp option update show_on_front page >/dev/null
wp option update page_on_front "$SHOP_ID" >/dev/null

%{ if seed_products ~}
echo "==> storefront products (SKUs matched to the Compound catalog)"
# Wipe first so re-running a deploy cannot duplicate the catalog.
for id in $(wp wc product list --user='${wp_admin_user}' --field=id 2>/dev/null); do
  wp wc product delete "$id" --force --user='${wp_admin_user}' >/dev/null 2>&1 || true
done
PRODUCTS=(
  "glp1-starter|Semaglutide 5 mg/mL|199|Semaglutide is a synthetic peptide with the molecular formula C187H291N45O59. This listing provides product identity and analytical information only.|DEMO-SEM5-001"
  "glp1-plus|Semaglutide 10 mg/mL|299|Semaglutide is a synthetic peptide with the molecular formula C187H291N45O59. This listing provides product identity and analytical information only.|DEMO-SEM10-001"
  "tirz-pro|Tirzepatide 10 mg/mL|399|Tirzepatide is a synthetic peptide with the molecular formula C225H348N48O68. This listing provides product identity and analytical information only.|DEMO-TIR10-001"
  "recovery-bpc|Pentadecapeptide BPC-157 5 mg|149|BPC-157 is a synthetic pentadecapeptide with the molecular formula C62H98N16O22. This listing provides product identity and analytical information only.|DEMO-BPC5-001"
)
for row in "$${PRODUCTS[@]}"; do
  IFS='|' read -r sku name price blurb lot <<< "$row"
  coa_id="$(wp post create --post_type=page --post_status=publish --post_title="Certificate of Analysis - $name" \
    --post_content="<h2>Certificate of Analysis</h2><table><tr><th>Analyte</th><td>$name</td></tr><tr><th>Lot</th><td>$lot</td></tr><tr><th>Laboratory</th><td>Demo Analytical Laboratory</td></tr><tr><th>Method</th><td>HPLC identity and purity analysis</td></tr><tr><th>Report date</th><td>2026-08-01</td></tr><tr><th>Result</th><td>Demo laboratory record - replace with the lot-specific third-party report before live sale.</td></tr></table>" --porcelain)"
  coa_url="$(wp post url "$coa_id")"
  image_id="$(wp eval '$upload=wp_upload_dir();$name="compound-product-".wp_generate_uuid4().".png";$path=$upload["path"]."/".$name;$image=imagecreatetruecolor(800,800);$bg=imagecolorallocate($image,241,245,249);$ink=imagecolorallocate($image,15,23,42);imagefill($image,0,0,$bg);imagestring($image,5,300,390,"Scientific Product",$ink);imagepng($image,$path);imagedestroy($image);$attachment=array("post_mime_type"=>"image/png","post_title"=>"Scientific product image","post_status"=>"inherit");$id=wp_insert_attachment($attachment,$path);require_once ABSPATH."wp-admin/includes/image.php";wp_update_attachment_metadata($id,wp_generate_attachment_metadata($id,$path));echo $id;')"
  wp wc product create --user='${wp_admin_user}' --name="$name" --sku="$sku" \
    --regular_price="$price" --description="$blurb" --short_description="$blurb" \
    --type=simple --manage_stock=false --images="[{\"id\":$image_id}]" \
    --meta_data="[{\"key\":\"_compound_coa_url\",\"value\":\"$coa_url\"},{\"key\":\"_compound_lot_number\",\"value\":\"$lot\"},{\"key\":\"_compound_lab_name\",\"value\":\"Demo Analytical Laboratory\"},{\"key\":\"_compound_analysis_type\",\"value\":\"HPLC identity and purity\"},{\"key\":\"_compound_coa_date\",\"value\":\"2026-08-01\"}]" >/dev/null 2>&1
  echo "    $sku  $name  \$$price"
done

echo "==> theme + branding (Storefront)"
wp theme install storefront --activate >/dev/null 2>&1 || true
wp theme mod set storefront_header_background_color "#0f172a" >/dev/null 2>&1 || true
wp theme mod set storefront_header_text_color "#e2e8f0" >/dev/null 2>&1 || true
wp theme mod set storefront_header_link_color "#ffffff" >/dev/null 2>&1 || true
wp theme mod set storefront_accent_color "#2563eb" >/dev/null 2>&1 || true
wp theme mod set button_background_color "#2563eb" >/dev/null 2>&1 || true
wp theme mod set button_text_color "#ffffff" >/dev/null 2>&1 || true
wp theme mod set storefront_footer_background_color "#0f172a" >/dev/null 2>&1 || true
%{ endif ~}

echo "==> Compound gateway settings"
# Built with python3 rather than string-concatenated so a key or secret containing
# a quote can never produce malformed JSON.
SETTINGS="$(python3 - <<'PY'
import json, os

key = os.environ.get("COMPOUND_API_KEY", "")
configured = key not in ("", "unset")

print(json.dumps({
    "enabled": "yes" if configured else "no",
    "title": "Card (Compound)",
    "description": "Test checkout via the Compound ${compound_environment}.",
    "environment": "${compound_environment}",
    "api_key": key if configured else "",
    # Orders and Payments are one public host, routed by path - orders_url and
    # payments_url below are always set to the same value; api_base is the one the
    # gateway actually reads (see WC_Gateway_Compound::migrate_legacy_settings).
    "api_base": "${orders_url}",
    "webhook_secret": os.environ.get("COMPOUND_WEBHOOK_SECRET", ""),
    "enable_card": "yes",
    "enable_ach": "yes",
    "enable_crypto": "yes",
}))
PY
)"
wp option update woocommerce_compound_settings "$SETTINGS" --format=json >/dev/null

if [ "$COMPOUND_API_KEY" = "unset" ]; then
  echo "    no API key set - the gateway is installed but disabled."
  echo "    Set compound_api_key in terraform.tfvars and re-deploy, or fill it in at"
  echo "    ${site_url}/wp-admin/admin.php?page=wc-settings&tab=checkout&section=compound"
else
  wp compound sync_coupons >/dev/null 2>&1 || true
  echo "    gateway enabled against ${orders_url}"
fi

wp cache flush >/dev/null 2>&1 || true

echo ""
echo "Store:    ${site_url}"
echo "Admin:    ${site_url}/wp-admin  (user '${wp_admin_user}')"
echo "Webhook:  ${site_url}/wp-json/compound/v1/webhook"
