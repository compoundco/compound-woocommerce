# Generated by Terraform - edits made on the instance are overwritten on the next
# deploy. The local docker-compose.test.yml's shape, with two changes for a public
# site: Caddy terminates TLS in front of Apache, and nothing but Caddy binds a host
# port. Secrets come from ./.env, written at boot from SSM Parameter Store.
services:
  db:
    image: mariadb:lts
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: wordpress
      MARIADB_USER: wordpress
      MARIADB_PASSWORD: $${DB_PASSWORD}
      MARIADB_ROOT_PASSWORD: $${DB_PASSWORD}
    volumes:
      - db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 3s
      retries: 30

  wordpress:
    # Newer than the local docker-compose.test.yml's 6.7 on purpose: current
    # WooCommerce declares "Requires at least: 6.9" and wordpress.org refuses the
    # install below that, so a 6.7 base leaves the store with no WooCommerce at all.
    image: wordpress:7.0-php8.3-apache
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: $${DB_PASSWORD}
      WORDPRESS_DB_NAME: wordpress
      # Behind Caddy, PHP only ever sees plain HTTP on the container network. Without
      # the X-Forwarded-Proto handoff WordPress builds http:// URLs, which the site's
      # https:// canonical then redirects - an infinite loop in wp-admin.
      #
      # $$_SERVER, not $_SERVER: compose substitutes $VAR in the file it reads, so a
      # bare $_SERVER expands to "" and silently strips the PHP out. The $$ escapes
      # it back to a literal $ for PHP. (Terraform passes $$ through untouched - only
      # $${ is meaningful to it.)
      WORDPRESS_CONFIG_EXTRA: |
        define( 'WP_HOME', '${site_url}' );
        define( 'WP_SITEURL', '${site_url}' );
        if ( isset( $$_SERVER['HTTP_X_FORWARDED_PROTO'] ) && 'https' === $$_SERVER['HTTP_X_FORWARDED_PROTO'] ) {
            $$_SERVER['HTTPS'] = 'on';
        }
        if ( isset( $$_SERVER['HTTP_X_FORWARDED_FOR'] ) ) {
            $$_SERVER['REMOTE_ADDR'] = trim( explode( ',', $$_SERVER['HTTP_X_FORWARDED_FOR'] )[0] );
        }
        define( 'FORCE_SSL_ADMIN', true );
        define( 'DISALLOW_FILE_EDIT', true );
    volumes:
      - wp:/var/www/html
      - ./compound-woocommerce:/var/www/html/wp-content/plugins/compound-woocommerce:ro

  cli:
    image: wordpress:cli-php8.3
    user: "33:33" # www-data, matches the wordpress image's file ownership
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: $${DB_PASSWORD}
      WORDPRESS_DB_NAME: wordpress
      WP_CLI_CACHE_DIR: /tmp/.wp-cli-cache
    volumes:
      - wp:/var/www/html
      - ./compound-woocommerce:/var/www/html/wp-content/plugins/compound-woocommerce:ro
    entrypoint: ["tail", "-f", "/dev/null"]

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on:
      - wordpress
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      # Certificates and ACME account keys persist here; losing this volume means
      # re-issuing on next boot and burning Let's Encrypt rate limit.
      - caddy_data:/data
      - caddy_config:/config

volumes:
  db:
  wp:
  caddy_data:
  caddy_config:
