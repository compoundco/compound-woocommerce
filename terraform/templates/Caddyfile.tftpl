# Generated by Terraform. Caddy obtains and renews a Let's Encrypt certificate for
# the sslip.io hostname automatically; nothing else is needed for HTTPS.
{
%{~ if acme_email != "" }
	email ${acme_email}
%{~ endif }
}

${hostname} {
	encode zstd gzip

	# WooCommerce plugin/theme uploads and media go through here.
	request_body {
		max_size 64MB
	}
%{~ if basic_auth_user != "" }

	# Staging gate: password-protect the whole store EXCEPT the Compound webhook
	# endpoint - Compound's outbound worker posts fulfillment status there and cannot
	# send basic-auth credentials, so that one path must stay open (it verifies its
	# own HMAC signature).
	@gated not path /wp-json/compound/v1/webhook*
	basic_auth @gated {
		${basic_auth_user} ${basic_auth_hash}
	}
%{~ endif }

	reverse_proxy wordpress:80 {
		header_up X-Forwarded-Proto https
	}
}

%{~ if length(redirect_domains) > 0 }

# Parked names pointed at this box that must not serve the store. Without a site block
# they resolve here and fail TLS outright, which shows a browser security warning rather
# than a redirect. This gives each one a certificate and sends it to the canonical host.
# Redirect only - no reverse_proxy - so no storefront content is reachable here and the
# 21+ age gate and staging basic-auth gate on ${hostname} are never bypassed.
${join(", ", redirect_domains)} {
	redir https://${hostname}{uri} permanent
}
%{~ endif }
