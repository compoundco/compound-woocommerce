#!/bin/bash
# Generated by Terraform, fetched from S3 on every run by the thin
# /usr/local/bin/compound-store-deploy wrapper that user-data installs. Living in
# the bundle rather than in user-data is what makes it fixable on a running store:
# user-data executes on first boot only.
#
# Pulls the current bundle, restarts the stack, re-runs provisioning. Data (the
# database, uploads, TLS certificates) lives in docker volumes and survives.
set -euo pipefail

APP_DIR=/opt/compound-store
BUCKET=${bucket}
SSM_PREFIX=${ssm_prefix}
REGION=${region}

cd "$APP_DIR"

# Secrets: SecureStrings from Parameter Store, written root-only.
ssm_get() {
  aws ssm get-parameter --region "$REGION" --name "$SSM_PREFIX/$1" \
    --with-decryption --query Parameter.Value --output text
}

# The umask stays inside the subshell on purpose: leaking 077 into the rest of the
# script extracts the plugin as root-only, and the containers (uid 33) then get
# "Permission denied" on a directory that looks perfectly correct from the host.
(
  umask 077
  {
    echo "DB_PASSWORD=$(ssm_get db_password)"
    echo "WP_ADMIN_PASSWORD=$(ssm_get wp_admin_password)"
    echo "COMPOUND_API_KEY=$(ssm_get compound_api_key)"
    echo "COMPOUND_WEBHOOK_SECRET=$(ssm_get compound_webhook_secret)"
  } > "$APP_DIR/.env"
)
chmod 600 "$APP_DIR/.env"

aws s3 cp --only-show-errors "s3://$BUCKET/docker-compose.yml" "$APP_DIR/docker-compose.yml"
aws s3 cp --only-show-errors "s3://$BUCKET/Caddyfile" "$APP_DIR/Caddyfile"
aws s3 cp --only-show-errors "s3://$BUCKET/provision.sh" "$APP_DIR/provision.sh"
aws s3 cp --only-show-errors "s3://$BUCKET/compound-woocommerce.zip" /tmp/compound-woocommerce.zip
chmod +x "$APP_DIR/provision.sh"

# Clear the directory's contents, never the directory itself. It is bind-mounted
# into containers that are already running; replacing it swaps the inode out from
# under them and the plugin silently disappears from wp-content/plugins, with
# nothing in any log but "plugin could not be found".
mkdir -p "$APP_DIR/compound-woocommerce"
find "$APP_DIR/compound-woocommerce" -mindepth 1 -delete
unzip -q -o /tmp/compound-woocommerce.zip -d "$APP_DIR"
# WordPress and wp-cli run as uid 33 inside the containers; the mount has to be
# readable by them, not just by root.
chmod -R a+rX "$APP_DIR/compound-woocommerce"

# --quiet-pull: layer-by-layer progress is tens of thousands of stderr lines, which
# buries the actual error when a deploy fails.
docker compose --project-directory "$APP_DIR" up -d --remove-orphans --quiet-pull

"$APP_DIR/provision.sh"
