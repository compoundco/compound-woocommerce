# The PRODUCTION storefront: chefspeps.com, its own EC2 instance, database, and Elastic
# IP, entirely separate from the staging store at stg.chefspeps.com. Lives in the `prod`
# Terraform workspace - never apply this file from the default workspace, or it will
# rewrite staging. Use `make aws-up-prod` / `make aws-deploy-prod`, which select the
# workspace and this file together.

region = "us-east-1"

# Distinct from the staging store's "compound-store". Every globally-unique name in this
# stack derives from it (S3 bucket, IAM role + instance profile, security group, SSM
# parameter prefix), so the two stores cannot collide.
name = "compound-store-prod"

# Guard: apply fails fast if the credentials resolve to any other account.
aws_account_id = "416339521945"
aws_profile    = "compound"

# --- Compound gateway ---------------------------------------------------------

# Points at PRODUCTION Compound. Live since the HTTPS cutover on app/ops/api.
compound_environment  = "live"
compound_orders_url   = "https://api.thepeptides.company"
compound_payments_url = "https://api.thepeptides.company"

# Deliberately empty. The store is wired to production but must not transact yet: with no
# key the gateway installs disabled, so nothing can reach production payments by accident.
# Going live is two explicit steps - paste a real sk_... here, and drop the basic-auth gate
# below - neither of which happens as a side effect of a deploy.
compound_api_key = ""

# --- Store --------------------------------------------------------------------

# The apex is the storefront; www redirects to it. Both A records must point at THIS
# stack's Elastic IP (printed by `make aws-url-prod`) before apply, or Caddy cannot
# complete the Let's Encrypt HTTP-01 challenge. They currently point at the staging box.
site_domain      = "chefspeps.com"
redirect_domains = ["www.chefspeps.com"]
acme_email       = "damien.kan@gmail.com"

# Still gated. This is a production-wired store that no shopper reaches yet, so the
# compliance controls (21+ age gate, account-only checkout, COA per product) can be
# verified before anything is purchasable. Removing this is the go-live decision.
# User: compoundrx  (password given out of band; same hash as staging)
basic_auth_user = "compoundrx"
basic_auth_hash = "" # bcrypt: caddy hash-password (or htpasswd -bnBC 10 "" <pass>)

site_title     = "Chefs Peps"
wp_admin_user  = "admin"
wp_admin_email = "admin@example.com"

# Demo catalog stays off here: a production storefront starts empty and gets real
# products, not the development fixtures the staging store carries.
seed_products = false

# --- Infrastructure -----------------------------------------------------------

instance_type    = "t3.small"
root_volume_size = 30
